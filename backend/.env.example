# Email Configuration for Production
EMAIL_HOST_USER=csesa.website@gmail.com
EMAIL_HOST_PASSWORD=your-app-password-here

# IMPORTANT: For Gmail setup, you need to:
# 1. Create a Gmail account for CSESA (e.g., csesa.website@gmail.com)
# 2. Enable 2-factor authentication on the Gmail account
# 3. Generate an "App Password" specifically for this Django application
# 4. Use the 16-character app password (not your regular Gmail password)
# 5. Copy this file to .env and fill in the actual values

# The contact form will send emails TO: csesa@iiti.ac.in
# The emails will be sent FROM: the Gmail account specified above