# Server
NODE_ENV=production
PORT=3000
PUBLIC_URL=https://csesa.iiti.ac.in
FRONTEND_ORIGIN=https://csesa.iiti.ac.in

# MySQL (CloudPanel-provisioned database)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=csesa
DB_USER=csesa
DB_PASSWORD=replace-me

# Generate a long, random value: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret

# Optional SMTP: contact messages are always saved even if this is unset.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CONTACT_EMAIL=csesa@iiti.ac.in
MAIL_FROM="CSESA Website <noreply@csesa.iiti.ac.in>"
